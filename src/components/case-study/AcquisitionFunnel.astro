---
// Horizontal proportional-bar funnel. Per the client brief: bar width is
// always relative to the first stage (total contacts), never stage-to-stage —
// that note is rendered as the caption so the chart can't be misread as a
// conversion-rate funnel.
interface Stage {
  label: string;
  value: number;
}

interface Props {
  title: string;
  stages: Stage[];
  note: string;
  surface?: "paper" | "ink";
}

const { title, stages, note, surface = "paper" } = Astro.props;
const max = stages[0]?.value ?? 1;
---

<div class:list={["acq-funnel", surface === "ink" && "acq-funnel-ink"]}>
  <p class="text-caption acq-funnel-title">{title}</p>
  <ul class="acq-funnel-list">
    {
      stages.map((stage, i) => (
        <li class="acq-funnel-row">
          <span class="text-small acq-funnel-label">{stage.label}</span>
          <span class="acq-funnel-bar-track">
            <span
              class:list={["acq-funnel-bar", i === stages.length - 1 && "acq-funnel-bar-final"]}
              data-acq-fill
              style={`width:${Math.max(4, (stage.value / max) * 100)}%`}
            />
          </span>
          <span class="text-h3 acq-funnel-value tabular-nums" data-count={stage.value.toLocaleString("en-US")}>
            {stage.value.toLocaleString("en-US")}
          </span>
        </li>
      ))
    }
  </ul>
  <p class="text-caption acq-funnel-note">{note}</p>
</div>

<style>
  .acq-funnel-title {
    color: var(--color-olive);
    margin-bottom: var(--space-4);
  }

  .acq-funnel-ink .acq-funnel-title {
    /* olive on ink is borderline-low-contrast (~3.2:1, under the 4.5:1
       text minimum) — ink-soft is the color already used for secondary
       text on ink sections elsewhere on this page and passes ~5.4:1. */
    color: var(--color-ink-soft);
  }

  .acq-funnel-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .acq-funnel-row {
    display: grid;
    grid-template-columns: 112px 1fr 88px;
    align-items: center;
    gap: var(--space-4);
  }

  .acq-funnel-row:hover .acq-funnel-bar {
    background: var(--color-ink);
  }

  .acq-funnel-row:hover .acq-funnel-bar-final {
    background: var(--color-olive);
  }

  .acq-funnel-label {
    color: var(--color-ink);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .acq-funnel-bar-track {
    display: block;
    height: 10px;
    border-radius: var(--radius-pill);
    background: var(--color-paper-2);
    overflow: hidden;
  }

  .acq-funnel-bar {
    display: block;
    height: 100%;
    border-radius: var(--radius-pill);
    background: var(--color-olive);
    transition: width var(--dur-draw) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }

  .acq-funnel-bar-final {
    background: var(--color-ink);
  }

  .acq-funnel-value {
    text-align: right;
    font-weight: 400;
    color: var(--color-ink);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .acq-funnel-note {
    margin-top: var(--space-4);
    color: var(--color-ink-soft);
  }

  /* Dark-surface variant (used on the Meta Ads / ink-background channel
     section). Without this, labels/value stayed the default ink color
     and the final bar's fill was literally var(--color-ink) — both
     invisible against an ink section background. Bug report: "black
     text on black background... you need to switch this." */
  .acq-funnel-ink .acq-funnel-label {
    color: var(--color-paper);
  }

  .acq-funnel-ink .acq-funnel-value {
    color: var(--color-paper);
  }

  .acq-funnel-ink .acq-funnel-bar-track {
    /* A dark grey, not paper-2 — visibly distinct from the ink section
       background behind it without looking like a mismatched light chip. */
    background: var(--color-line-dark);
  }

  .acq-funnel-ink .acq-funnel-bar-final {
    background: var(--color-bone);
  }

  .acq-funnel-ink .acq-funnel-row:hover .acq-funnel-bar {
    background: var(--color-bone);
  }

  .acq-funnel-ink .acq-funnel-row:hover .acq-funnel-bar-final {
    background: var(--color-olive);
  }

  @media (max-width: 480px) {
    .acq-funnel-row {
      grid-template-columns: 88px 1fr 64px;
      gap: var(--space-3);
    }
  }
</style>

<script>
  // Progressive-enhancement reveal: bars render at full width without JS
  // (via the inline `style` set above). With JS, zero them out and grow
  // to that width once scrolled into view, for the "bar fills in" feel.
  // tokens.css already zeroes --dur-draw under prefers-reduced-motion, so
  // the transition becomes instant there rather than needing a branch.
  document.querySelectorAll<HTMLElement>("[data-acq-fill]").forEach((bar) => {
    const target = bar.style.width;
    bar.style.width = "0%";
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            bar.style.width = target;
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(bar);
  });
</script>
