---
// A scaled-down recreation of a case-study page's own real hero banner —
// kicker + title + intro, plus a figure slot (the ring or DeviceFrame
// WorkFeatures.astro passes in) — used by the "Selected work" mockups so
// each one reads as that project's actual hero, not a generic preview.
interface Props {
  kicker: string;
  title: string;
  intro: string;
  variant: "stack" | "split";
}

const { kicker, title, intro, variant } = Astro.props;
---

<div class:list={["fhm", `fhm-${variant}`]}>
  <div class="fhm-copy">
    <p class="text-caption fhm-kicker">{kicker}</p>
    <p class="fhm-title">{title}</p>
    <p class="text-caption fhm-intro">{intro}</p>
  </div>
  <div class="fhm-figure">
    <slot />
  </div>
</div>

<style>
  .fhm {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-paper);
    overflow: hidden;
  }

  .fhm-copy {
    min-width: 0;
  }

  .fhm-kicker {
    color: var(--color-ink-soft);
  }

  .fhm-title {
    margin-top: var(--space-2);
    font-size: clamp(1.125rem, 2.2vw + 0.5rem, 1.5rem);
    font-weight: 450;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .fhm-intro {
    margin-top: var(--space-3);
    color: var(--color-olive);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .fhm-figure {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fhm-stack {
    flex-direction: column;
  }

  .fhm-split {
    flex-direction: row;
    align-items: center;
  }

  .fhm-split .fhm-copy {
    flex: 1 1 55%;
  }

  .fhm-split .fhm-figure {
    flex: 1 1 45%;
    height: 100%;
  }

  .fhm-split .fhm-intro {
    -webkit-line-clamp: 3;
  }
</style>
