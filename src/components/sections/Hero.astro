---
// DESIGN-SYSTEM.md §6.1, revision 2026-10-07 (b) — figure fills the first
// screen (--hero-cutout-h derived from the fold), the label/rule/year merge
// into one left rail, and the headline jumps to --text-display-xl.
import { Image } from "astro:assets";
import Container from "../layout/Container.astro";
import Metric from "../ui/Metric.astro";
import SystemMap from "../system/SystemMap.astro";
import kemalPortrait from "../../assets/images/kemal-portrait.png";
import { hero, systemMapNodes } from "../../data/site";

// Display headline token is a function of the copy, not a fixed choice
// (DESIGN-SYSTEM.md §6.1 "Display headline" guard rail / §4.2 table).
const headlineWords = hero.headline.trim().split(/\s+/).filter(Boolean);
const isShortHeadline = headlineWords.length <= 2 && hero.headline.length <= 12;
---

<section id="top" class="hero" data-surface="paper">
  <div class="hero-content">
    <div class="hero-rail">
      <span class="hero-rail-label">{hero.rotatedLabel}</span>
      <div class="hero-rail-rule" aria-hidden="true"></div>
      <span class="hero-rail-year">{hero.year}</span>
    </div>

    <Container class="hero-grid">
      <div class="hero-text">
        <div class="hero-top-stats">
          {hero.topStats.map((stat) => <Metric value={stat.value} label={stat.label} />)}
        </div>

        <h1 class:list={["hero-headline", isShortHeadline ? "text-display-xl" : "text-display"]}>
          {hero.headline}
        </h1>

        <p class="text-lead hero-lead">{hero.lead}</p>

        <div class="hero-rule" aria-hidden="true"></div>

        <div class="hero-footer-row">
          <span class="text-caption tabular-nums hero-year">{hero.year}</span>
          <span class="text-small hero-scroll-cue">{hero.scrollCue}</span>
        </div>
      </div>

      <div class="hero-portrait">
        <Image
          class="hero-portrait-img"
          src={kemalPortrait}
          alt="Portrait of Kemal"
          width={1440}
          height={2560}
          loading="eager"
          decoding="async"
        />
      </div>
    </Container>
  </div>

  <div class="hero-map hairline-top">
    <Container>
      <SystemMap nodes={systemMapNodes} />
      <div class="hero-impact-row">
        {hero.impactStats.map((stat) => <Metric value={stat.value} label={stat.label} />)}
      </div>
    </Container>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-paper);
    padding-top: var(--space-8);
    overflow: hidden;
  }

  .hero-content {
    position: relative;
  }

  .hero-rail {
    display: none;
  }

  :global(.hero-grid) {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-content: start;
    min-height: auto;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-self: stretch;
    gap: var(--space-6);
  }

  .hero-top-stats {
    display: flex;
    gap: var(--space-7);
    max-width: 320px;
  }

  .hero-headline {
    max-width: 16ch;
  }

  .hero-lead {
    max-width: 48ch;
    color: var(--color-olive);
  }

  .hero-rule {
    width: 1px;
    height: var(--hero-rule-h);
    background: var(--color-line);
  }

  .hero-footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    color: var(--color-olive);
  }

  .hero-portrait {
    /* the box IS the figure — crop box, not a backdrop (DESIGN-SYSTEM.md §6.1) */
    aspect-ratio: var(--hero-cutout-ar);
    overflow: hidden;
    justify-self: end;
    align-self: end;
    width: min(
      calc(var(--hero-cutout-h-sm) * 1048 / 1798),
      calc(100% + var(--container-pad) + var(--hero-cutout-bleed))
    );
    margin-right: calc(-1 * var(--container-pad) - var(--hero-cutout-bleed));
  }

  .hero-portrait-img {
    display: block;
    /* global.css sets `img { max-width: 100% }`; without this override the
       browser clamps the crop box's scale-up and the whole crop math below
       silently breaks (figure renders short, with empty box below it). */
    max-width: none;
    width: 137.40%;
    height: auto;
    margin-left: -28.24%;
    margin-top: -72.71%;
  }

  .hero-map {
    margin-top: 0;
  }

  .hero-map :global(.system-map) {
    padding-block: var(--space-7);
  }

  .hero-impact-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
    padding-bottom: var(--space-8);
  }

  @media (min-width: 768px) {
    .hero-impact-row {
      grid-template-columns: repeat(4, 1fr);
    }

    .hero-portrait {
      width: min(
        calc(var(--hero-cutout-h-md) * 1048 / 1798),
        calc(100% + var(--container-pad) + var(--hero-cutout-bleed))
      );
    }
  }

  @media (min-width: 1024px) {
    .hero-rail {
      display: flex;
      position: absolute;
      inset-block: 0;
      left: var(--space-3);
      flex-direction: column;
      align-items: center;
      padding-top: var(--space-5);
      padding-bottom: var(--space-5);
    }

    .hero-rail-label,
    .hero-rail-year {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-size: var(--text-caption);
      font-weight: 450;
      letter-spacing: 0.01em;
      color: var(--color-olive);
      white-space: nowrap;
    }

    .hero-rail-year {
      font-variant-numeric: tabular-nums lining-nums;
    }

    .hero-rail-rule {
      flex: 1 1 auto;
      width: 1px;
      min-height: var(--space-8);
      background: var(--color-line);
      margin-block: var(--space-6) var(--space-4);
    }

    .hero-rule {
      display: none;
    }

    :global(.hero-grid) {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      min-height: var(--hero-row-h);
      align-items: stretch;
    }

    .hero-text {
      padding-top: var(--space-8);
      gap: 0;
      margin-right: calc(var(--hero-figure-reserve) + var(--hero-figure-gap));
      max-width: var(--hero-text-max);
    }

    .hero-top-stats {
      margin-bottom: var(--space-8);
    }

    .hero-headline {
      max-width: 11ch;
      margin-bottom: var(--space-5);
    }

    .hero-lead {
      max-width: 40ch;
    }

    .hero-footer-row {
      justify-content: flex-start;
    }

    .hero-footer-row .hero-year {
      display: none;
    }

    .hero-portrait {
      position: absolute;
      bottom: 0;
      right: calc(-1 * var(--hero-cutout-bleed));
      width: var(--hero-figure-w);
      height: var(--hero-figure-h);
      aspect-ratio: auto;
      margin-right: 0;
    }
  }
</style>
