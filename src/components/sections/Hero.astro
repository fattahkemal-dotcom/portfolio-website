---
// DESIGN-SYSTEM.md §6.1 (revised 2026-10-05 — CTAs removed, portrait is now
// a true alpha cutout, no bone mount).
import { Image } from "astro:assets";
import Container from "../layout/Container.astro";
import Metric from "../ui/Metric.astro";
import SystemMap from "../system/SystemMap.astro";
import kemalPortrait from "../../assets/images/kemal-portrait.png";
import { hero, systemMapNodes } from "../../data/site";
---

<section id="top" class="hero" data-surface="paper">
  <div class="hero-edge-label" aria-hidden="true">
    <span>{hero.rotatedLabel}</span>
  </div>

  <Container class="hero-grid">
    <div class="hero-text">
      <div class="hero-top-stats">
        {hero.topStats.map((stat) => <Metric value={stat.value} label={stat.label} />)}
      </div>

      <h1 class="text-display hero-headline">{hero.headline}</h1>

      <p class="text-lead hero-lead">{hero.lead}</p>

      <div class="hero-rule" aria-hidden="true"></div>

      <div class="hero-footer-row">
        <span class="text-caption tabular-nums hero-year">{hero.year}</span>
        <span class="text-small hero-scroll-cue">{hero.scrollCue}</span>
      </div>
    </div>

    <div class="hero-portrait">
      <Image
        class="hero-portrait-img"
        src={kemalPortrait}
        alt="Portrait of Kemal"
        width={1440}
        height={2560}
        loading="eager"
        decoding="async"
      />
    </div>
  </Container>

  <div class="hero-map hairline-top">
    <Container>
      <SystemMap nodes={systemMapNodes} />
      <div class="hero-impact-row">
        {hero.impactStats.map((stat) => <Metric value={stat.value} label={stat.label} />)}
      </div>
    </Container>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-paper);
    padding-top: var(--space-8);
    overflow: hidden;
  }

  .hero-edge-label {
    display: none;
  }

  :global(.hero-grid) {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: center;
    align-content: start;
    min-height: 60svh;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-self: stretch;
    gap: var(--space-6);
  }

  .hero-top-stats {
    display: flex;
    gap: var(--space-7);
    max-width: 320px;
  }

  .hero-headline {
    max-width: 16ch;
  }

  .hero-lead {
    max-width: 48ch;
    color: var(--color-olive);
  }

  .hero-rule {
    width: 1px;
    height: var(--hero-rule-h);
    background: var(--color-line);
  }

  .hero-footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    color: var(--color-olive);
  }

  .hero-portrait {
    justify-self: end;
    align-self: end;
    width: fit-content;
    margin-right: calc(-1 * var(--container-pad) - var(--space-4));
  }

  .hero-portrait-img {
    display: block;
    height: var(--hero-cutout-h-sm);
    width: auto;
  }

  .hero-map {
    margin-top: 0;
  }

  .hero-map :global(.system-map) {
    padding-block: var(--space-7);
  }

  .hero-impact-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
    padding-bottom: var(--space-8);
  }

  @media (min-width: 768px) {
    .hero-impact-row {
      grid-template-columns: repeat(4, 1fr);
    }

    .hero-portrait-img {
      height: var(--hero-cutout-h-md);
    }
  }

  @media (min-width: 1024px) {
    .hero {
      padding-left: var(--space-7);
    }

    .hero-edge-label {
      display: flex;
      position: absolute;
      left: var(--space-3);
      top: var(--space-8);
      bottom: 0;
      align-items: flex-start;
    }

    .hero-edge-label span {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-size: var(--text-caption);
      font-weight: 450;
      letter-spacing: 0.01em;
      color: var(--color-olive);
    }

    :global(.hero-grid) {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      gap: var(--space-8);
    }

    .hero-headline {
      max-width: 14ch;
    }

    .hero-lead {
      max-width: 44ch;
    }

    .hero-portrait {
      margin-right: calc(-1 * var(--container-pad) - var(--space-5));
    }

    .hero-portrait-img {
      height: var(--hero-cutout-h);
    }
  }

  @media (min-width: 1320px) {
    .hero-portrait {
      margin-right: calc(-50vw + var(--container-max) / 2 - var(--space-5));
    }
  }
</style>
