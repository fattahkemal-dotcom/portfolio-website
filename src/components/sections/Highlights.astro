---
// DESIGN-SYSTEM.md §6.1A — Highlights marquee. Client-directed §10 override
// (dated, narrowed): auto-scroll is otherwise banned by this file's own
// anti-slop rule. Pause control is required regardless of the reduced-motion
// setting because WCAG 2.2.2 (Level A) requires a stop control on any
// auto-playing motion longer than 5 seconds; prefers-reduced-motion also
// stops the scroll outright and collapses to a static wrapped row.
import { highlights } from "../../data/site";
---

<section class="highlights" data-surface="ink" aria-label="Highlights">
  <div class="highlights-marquee">
    <button
      type="button"
      class="highlights-toggle"
      data-marquee-toggle
      aria-pressed="false"
      aria-label="Pause running text"
    >
      <span class="highlights-toggle-icon" aria-hidden="true"></span>
    </button>

    <div class="highlights-track" data-marquee-track>
      <ul class="highlights-list">
        {
          highlights.map((item) => (
            <li class="highlights-item">
              <strong>{item.headline}</strong>
              <span>{item.description}</span>
            </li>
          ))
        }
      </ul>
      <ul class="highlights-list" aria-hidden="true">
        {
          highlights.map((item) => (
            <li class="highlights-item">
              <strong>{item.headline}</strong>
              <span>{item.description}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .highlights {
    background: var(--color-ink);
    color: var(--color-paper);
    overflow: hidden;
  }

  .highlights-marquee {
    position: relative;
    display: flex;
    align-items: center;
  }

  .highlights-marquee::after {
    /* edge fade so the loop seam reads as intentional, not a clipped crop */
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: var(--space-9);
    background: linear-gradient(to right, transparent, var(--color-ink));
    pointer-events: none;
  }

  .highlights-toggle {
    flex: 0 0 auto;
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-inline-start: var(--space-5);
    border: 1px solid var(--color-line-dark);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-paper);
    cursor: pointer;
    transition: border-color var(--dur-fast) ease-out;
  }

  .highlights-toggle:hover {
    border-color: var(--color-ink-soft);
  }

  .highlights-toggle-icon {
    position: relative;
    width: 8px;
    height: 10px;
  }

  .highlights-toggle-icon::before,
  .highlights-toggle-icon::after {
    content: "";
    position: absolute;
    top: 0;
    width: 3px;
    height: 10px;
    background: currentColor;
  }

  .highlights-toggle-icon::before {
    left: 0;
  }

  .highlights-toggle-icon::after {
    right: 0;
  }

  .highlights-toggle[aria-pressed="true"] .highlights-toggle-icon {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 5px 0 5px 8px;
    border-color: transparent transparent transparent currentColor;
  }

  .highlights-toggle[aria-pressed="true"] .highlights-toggle-icon::before,
  .highlights-toggle[aria-pressed="true"] .highlights-toggle-icon::after {
    display: none;
  }

  .highlights-track {
    display: flex;
    width: max-content;
    padding-block: var(--space-5);
    animation: highlights-scroll 36s linear infinite;
  }

  .highlights-track.is-paused {
    animation-play-state: paused;
  }

  .highlights-list {
    display: flex;
    flex-shrink: 0;
    list-style: none;
    gap: var(--space-8);
    padding-inline-start: var(--space-8);
  }

  .highlights-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    white-space: nowrap;
    font-size: var(--text-small);
  }

  .highlights-item strong {
    font-weight: 600;
    color: var(--color-paper);
  }

  .highlights-item span {
    color: var(--color-ink-soft);
  }

  @keyframes highlights-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .highlights-marquee::after {
      display: none;
    }

    .highlights-track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
    }

    .highlights-list[aria-hidden="true"] {
      display: none;
    }

    .highlights-toggle {
      display: none;
    }
  }
</style>

<script>
  const toggles = document.querySelectorAll<HTMLButtonElement>("[data-marquee-toggle]");

  toggles.forEach((toggle) => {
    const track = toggle
      .closest(".highlights")
      ?.querySelector<HTMLElement>("[data-marquee-track]");
    if (!track) return;

    toggle.addEventListener("click", () => {
      const isPaused = track.classList.toggle("is-paused");
      toggle.setAttribute("aria-pressed", String(isPaused));
      toggle.setAttribute("aria-label", isPaused ? "Play running text" : "Pause running text");
    });
  });
</script>
