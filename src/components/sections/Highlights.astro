---
// DESIGN-SYSTEM.md §6.1A — Highlights marquee. Client-directed §10 override
// (dated, narrowed): auto-scroll is otherwise banned by this file's own
// anti-slop rule. Client also asked to ship with no pause control
// (2026-10-19) — per §10's override note, that's a deliberate, written
// deviation from WCAG 2.2.2 (auto-motion over 5s normally needs a stop
// control), not an oversight. prefers-reduced-motion still stops the
// scroll outright and collapses the row to a static wrapped layout.
import { highlights } from "../../data/site";
---

<section class="highlights" data-surface="ink" aria-label="Highlights">
  <div class="highlights-marquee">
    <div class="highlights-track">
      <ul class="highlights-list">
        {
          highlights.map((item) => (
            <li class="highlights-item">
              <strong>{item.headline}</strong>
              <span>{item.description}</span>
            </li>
          ))
        }
      </ul>
      <ul class="highlights-list" aria-hidden="true">
        {
          highlights.map((item) => (
            <li class="highlights-item">
              <strong>{item.headline}</strong>
              <span>{item.description}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .highlights {
    background: var(--color-ink);
    color: var(--color-paper);
    overflow: hidden;
  }

  .highlights-marquee {
    position: relative;
    display: flex;
    align-items: center;
  }

  .highlights-marquee::after {
    /* edge fade so the loop seam reads as intentional, not a clipped crop */
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: var(--space-9);
    background: linear-gradient(to right, transparent, var(--color-ink));
    pointer-events: none;
  }

  .highlights-track {
    display: flex;
    width: max-content;
    padding-block: var(--space-5);
    animation: highlights-scroll 36s linear infinite;
  }

  .highlights-list {
    display: flex;
    flex-shrink: 0;
    list-style: none;
    gap: var(--space-8);
    padding-inline-start: var(--space-8);
  }

  .highlights-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    white-space: nowrap;
    font-size: var(--text-small);
  }

  .highlights-item strong {
    font-weight: 600;
    color: var(--color-paper);
  }

  .highlights-item span {
    color: var(--color-ink-soft);
  }

  @keyframes highlights-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .highlights-marquee::after {
      display: none;
    }

    .highlights-track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
    }

    .highlights-list[aria-hidden="true"] {
      display: none;
    }
  }
</style>
