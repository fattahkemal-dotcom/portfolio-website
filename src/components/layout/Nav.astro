---
// DESIGN-SYSTEM.md §7.5. Height 72px, bg paper, no blur/transparency.
// Hairline appears only after scrolling 8px. Mobile: full-screen paper
// overlay with links at text-h2.
import { navLinks, navCta, site } from "../../data/site";
import Button from "../ui/Button.astro";
---

<header class="nav-header" id="site-nav">
  <nav class="container nav-inner" aria-label="Primary">
    <a href="/" class="nav-logo">{site.name}</a>

    <ul class="nav-links">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>

    <div class="nav-cta">
      <Button href={navCta.href} variant="primary">{navCta.label}</Button>
    </div>

    <button type="button" class="nav-menu-toggle" aria-expanded="false" aria-controls="mobile-menu">
      Menu
    </button>
  </nav>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <ul class="mobile-menu-links">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
    <Button href={navCta.href} variant="primary">{navCta.label}</Button>
    <button type="button" class="mobile-menu-close" aria-label="Close menu">
      Close
    </button>
  </div>
</header>

<style>
  .nav-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-paper);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .nav-header[data-scrolled="true"] {
    border-bottom-color: var(--color-line);
  }

  .nav-inner {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .nav-logo {
    font-size: var(--text-h3);
    font-weight: 500;
    color: var(--color-ink);
  }

  .nav-links {
    display: none;
    list-style: none;
    gap: var(--space-6);
    font-size: var(--text-small);
  }

  .nav-links a:hover {
    color: var(--color-olive);
  }

  .nav-cta {
    display: none;
  }

  .nav-menu-toggle {
    font-size: var(--text-small);
    color: var(--color-ink);
    background: none;
    border: none;
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
      flex: 1;
      justify-content: center;
    }
    .nav-cta {
      display: block;
    }
    .nav-menu-toggle {
      display: none;
    }
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--color-paper);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-7);
    padding: var(--container-pad);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .mobile-menu[data-open="true"] {
    opacity: 1;
  }

  .mobile-menu-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .mobile-menu-links a {
    font-size: var(--text-h2);
    font-weight: 350;
    color: var(--color-ink);
  }

  .mobile-menu-close {
    position: absolute;
    top: var(--space-5);
    right: var(--container-pad);
    font-size: var(--text-small);
    background: none;
    border: none;
    color: var(--color-ink);
  }

  @media (min-width: 768px) {
    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  const header = document.getElementById("site-nav");
  const toggle = document.querySelector<HTMLButtonElement>(".nav-menu-toggle");
  const closeBtn = document.querySelector<HTMLButtonElement>(".mobile-menu-close");
  const menu = document.getElementById("mobile-menu");

  const onScroll = () => {
    header?.setAttribute("data-scrolled", window.scrollY > 8 ? "true" : "false");
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const openMenu = () => {
    if (!menu) return;
    menu.hidden = false;
    requestAnimationFrame(() => menu.setAttribute("data-open", "true"));
    toggle?.setAttribute("aria-expanded", "true");
  };

  const closeMenu = () => {
    if (!menu) return;
    menu.setAttribute("data-open", "false");
    toggle?.setAttribute("aria-expanded", "false");
    window.setTimeout(() => {
      menu.hidden = true;
    }, 250);
  };

  toggle?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
</script>
