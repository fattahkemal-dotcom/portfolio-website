---
// Case study page — "Turning Funnel Data into Acquisition Growth" (Gentem
// Indonesia). Built directly from the client's numbers-first brief rather
// than through the MDX content-collection pipeline PRD.md §6 describes
// (that pipeline — content.config.ts, @astrojs/mdx — doesn't exist in this
// repo yet); see handover.md for the note on reconciling the two later.
//
// 2026-10-25 revision: visual upgrade translating a client-supplied
// editorial-style reference (bold display type, oversized stats, scroll
// reveals) into THIS site's strict token set — Hanken Grotesk only (no
// serif/mono fonts), ink/olive/bone/paper palette only (no neon accent),
// no eyebrow labels above headings per DESIGN-SYSTEM.md §4.2. Reused
// --text-display / --text-display-xl, already defined for exactly this
// "oversized, short text" job, instead of inventing new sizes.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/layout/Section.astro";
import Container from "../../components/layout/Container.astro";
import Metric from "../../components/ui/Metric.astro";
import Tag from "../../components/ui/Tag.astro";
import Button from "../../components/ui/Button.astro";
import InteractiveFunnelChart from "../../components/case-study/InteractiveFunnelChart.astro";
import CostDeltaChart from "../../components/case-study/CostDeltaChart.astro";
import AcquisitionFunnel from "../../components/case-study/AcquisitionFunnel.astro";
import { caseStudy } from "../../data/case-studies/gentem-growth-strategy";

const { header, sidebar, glossary, overview, funnel, costPerFpdp, channels, closing } = caseStudy;

const pct = (v: number) => `${v.toFixed(1)}%`;
const idrM = (v: number) => `IDR ${v.toFixed(2)}M`;

const funnelSeries = funnel.rows.map((r) => ({
  id: r.label.toLowerCase().replace(/\s+/g, "-"),
  label: r.label,
  values: [...r.values],
}));

const costPoints = costPerFpdp.months
  .map((m, i) => ({ label: m as string, value: costPerFpdp.actual[i] as number | null }))
  .filter((p): p is { label: string; value: number } => p.value !== null)
  .map((p) => ({ ...p, formatted: idrM(p.value) }));
---

<BaseLayout title={caseStudy.meta.title} description={caseStudy.meta.description}>
  <Section id="case-study-header" background="paper" class="cs-header">
    <Container>
      <div class="cs-hero-grid">
        <div class="cs-hero-copy">
          <p class="text-caption cs-kicker">{header.kicker}</p>
          <h1 class="text-display cs-title">{header.title}</h1>
          <p class="text-lead cs-meta-line">
            {header.client} · {header.role} · {header.duration}
          </p>
          <p class="text-body cs-intro">{header.intro}</p>
        </div>

        <div class="cs-hero-figure" aria-hidden="true">
          <span class="cs-hero-ring cs-hero-ring-outer"></span>
          <span class="cs-hero-ring cs-hero-ring-mid"></span>
          <span class="cs-hero-ring cs-hero-ring-dashed"></span>
          <div class="cs-hero-figure-center">
            <p class="text-caption cs-hero-figure-label">January / performance</p>
            <p class="text-display-xl cs-hero-figure-value tabular-nums reveal" data-count={header.stats[0].value}>
              {header.stats[0].value}
            </p>
            <p class="text-caption cs-hero-figure-sub">{header.stats[0].label}</p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="proof" background="bone" class="cs-proof">
    <Container>
      <div class="cs-proof-header">
        <p class="text-caption">The numbers / at a glance</p>
        <p class="text-caption">Outcomes, not just outputs</p>
      </div>
      <div class="cs-proof-grid">
        {
          header.stats.map((stat) => (
            <div class="cs-proof-item">
              <p class="text-metric cs-proof-figure tabular-nums" data-count={stat.value}>
                {stat.value}
              </p>
              <p class="text-caption cs-proof-label">{stat.label}</p>
            </div>
          ))
        }
      </div>
      <p class="text-caption cs-footnote">{header.statsFootnote}</p>
    </Container>
  </Section>

  <Section id="overview" background="paper">
    <Container>
      <div class="cs-section-head hairline-top reveal">
        <h2 class="text-display cs-brief-display">The challenge wasn't<br />more traffic.</h2>
        <p class="text-caption cs-section-tag">01 / The brief</p>
      </div>

      <div class="cs-body-grid">
        <div class="cs-body">
          <section class="cs-block reveal">
            <h3 class="text-h3">The Challenge</h3>
            <p class="text-body cs-block-text">{overview.challenge}</p>
          </section>

          <section class="cs-block reveal">
            <h3 class="text-h3">The Strategy</h3>
            <ol class="cs-approach-list">
              {overview.strategy.map((line, i) => (
                <li class="cs-approach-row">
                  <span class="text-h3 cs-approach-index tabular-nums">{String(i + 1).padStart(2, "0")}</span>
                  <p class="text-body cs-approach-text">{line}</p>
                </li>
              ))}
            </ol>
          </section>

          <section class="cs-block reveal">
            <h3 class="text-h3">The Outcome</h3>
            <p class="text-body cs-block-text">{overview.outcome}</p>
          </section>
        </div>

        <aside class="cs-sidebar hairline-top reveal">
          <dl class="cs-sidebar-list">
            <div>
              <dt class="text-caption">Client</dt>
              <dd class="text-small">{sidebar.client}</dd>
            </div>
            <div>
              <dt class="text-caption">Industry</dt>
              <dd class="text-small">{sidebar.industry}</dd>
            </div>
            <div>
              <dt class="text-caption">Role</dt>
              <dd class="text-small">{sidebar.role}</dd>
            </div>
            <div>
              <dt class="text-caption">Duration</dt>
              <dd class="text-small">{sidebar.duration}</dd>
            </div>
            <div>
              <dt class="text-caption">Stack</dt>
              <dd class="cs-sidebar-tags">
                {sidebar.stack.map((tool) => <Tag>{tool}</Tag>)}
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </Container>
  </Section>

  <Section id="funnel-performance" background="paper-2">
    <Container>
      <div class="cs-section-head hairline-top reveal">
        <h2 class="text-display">{funnel.heading}</h2>
        <p class="text-caption cs-section-tag">02 / The evidence</p>
      </div>
      <p class="text-small cs-section-note reveal">{funnel.subheading}</p>

      <div class="cs-chart-stage reveal">
        <span class="cs-chart-stage-corner" aria-hidden="true"></span>
        <p class="text-caption cs-chart-stage-hint">Interactive performance explorer — select a stage below</p>
        <InteractiveFunnelChart
          months={[...funnel.months]}
          series={funnelSeries}
          defaultSeriesId="total-contract"
          yMax={funnel.yMax}
          yTicks={[...funnel.yTicks]}
          yFormat={pct}
          referenceLine={funnel.referenceLine}
          caption={funnel.caption}
        />
        <p class="text-caption cs-chart-caption">{funnel.caption}</p>

        <div class="cs-table-wrap">
          <table class="cs-table">
            <caption class="text-caption">Target Achievement (%) by funnel stage</caption>
            <thead>
              <tr>
                <th scope="col">Funnel stage</th>
                {funnel.months.map((m) => <th scope="col">{m}</th>)}
              </tr>
            </thead>
            <tbody>
              {
                funnel.rows.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    {row.values.map((v) => <td class="tabular-nums">{pct(v)}</td>)}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <div class="cs-insight reveal">
        <p class="cs-insight-figure tabular-nums" data-count={pct(funnel.rows[3].values[2])}>
          {pct(funnel.rows[3].values[2])}
        </p>
        <div class="cs-insight-copy">
          <p class="text-caption cs-section-tag">The important nuance</p>
          <p class="text-small cs-takeaway">{funnel.takeaway}</p>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="cost-per-fpdp" background="paper">
    <Container>
      <div class="cs-section-head hairline-top reveal">
        <h2 class="text-display">Efficient growth,<br />not just growth.</h2>
        <p class="text-caption cs-section-tag">03 / Cost efficiency</p>
      </div>

      <div class="cs-efficiency-grid">
        <div class="reveal">
          <p class="text-body cs-block-text">{costPerFpdp.subheading}</p>
          <p class="text-caption cs-glossary">{glossary.fpdp}</p>
          <p class="cs-efficiency-figure tabular-nums" data-count={header.stats[1].value}>
            {header.stats[1].value}
          </p>
          <p class="text-caption cs-efficiency-label">Cost per FPDP, Nov → Jan</p>
          <p class="text-small cs-takeaway">{costPerFpdp.takeaway}</p>
        </div>

        <div class="cs-chart-stage cs-chart-stage-tint reveal">
          <span class="cs-chart-stage-corner" aria-hidden="true"></span>
          <CostDeltaChart
            points={costPoints}
            unitLabel="Actual cost per FPDP, IDR millions"
            verdict="Less cost. More discipline."
          />
          <p class="text-caption cs-chart-caption">{costPerFpdp.referenceNote}</p>

          <div class="cs-callouts">
            {
              costPerFpdp.callouts.map((c) => (
                <div class="cs-callout">
                  <p class="text-caption cs-callout-month">{c.month}</p>
                  <p class="text-metric cs-callout-value tabular-nums">{c.value}</p>
                  <p class="text-small cs-callout-delta">{c.delta}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </Container>
  </Section>

  {
    channels.map((channel, i) => {
      const isDark = i === 1;
      return (
        <Section id={channel.id} background={isDark ? "ink" : "paper-2"}>
          <Container>
            <div class="cs-section-head hairline-top reveal" class:list={[isDark && "cs-on-ink"]}>
              <h2 class="text-display cs-channel-title" class:list={[isDark && "cs-on-ink"]}>{channel.title}</h2>
              <p class="text-caption cs-section-tag" class:list={[isDark && "cs-on-ink-soft"]}>
                {String(i + 4).padStart(2, "0")} / The channels
              </p>
            </div>
            <p class="text-body cs-intro reveal" class:list={[isDark && "cs-on-ink-soft"]}>{channel.intro}</p>

            <div class="cs-stats reveal">
              {channel.stats.map((stat) => (
                <Metric value={stat.value} label={stat.label} surface={isDark ? "ink" : "paper"} />
              ))}
            </div>

            <div class="cs-channel-grid">
              <div class="reveal">
                <h3 class="text-h3 cs-subheading" class:list={[isDark && "cs-on-ink"]}>{channel.architectureHeading}</h3>
                <ol class="cs-steps">
                  {channel.architecture.map((step) => (
                    <li class="cs-step">
                      <span class="text-caption cs-step-index tabular-nums" class:list={[isDark && "cs-on-ink-soft"]}>{step.step}</span>
                      <span class="text-h3 cs-step-stage" class:list={[isDark && "cs-on-ink"]}>{step.stage}</span>
                      <span class="text-caption cs-step-group" class:list={[isDark && "cs-on-ink-soft"]}>{step.group}</span>
                      <span class="text-small cs-step-note" class:list={[isDark && "cs-on-ink-soft"]}>{step.note}</span>
                    </li>
                  ))}
                </ol>
              </div>

              <div class="reveal">
                <h3 class="text-h3 cs-subheading" class:list={[isDark && "cs-on-ink"]}>Optimization Priorities</h3>
                <ul class="cs-list" class:list={[isDark && "cs-on-ink-soft"]}>
                  {channel.priorities.map((p) => (
                    <li class="text-body">{p}</li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="cs-funnel-wrap hairline-top reveal" class:list={[isDark && "cs-on-ink"]}>
              <AcquisitionFunnel
                title={channel.funnel.title}
                stages={[...channel.funnel.stages]}
                note={channel.funnel.note}
                surface={isDark ? "ink" : "paper"}
              />
            </div>
          </Container>
        </Section>
      );
    })
  }

  <Section id="closing" background="ink">
    <Container>
      <div class="cs-section-head reveal">
        <h2 class="text-display cs-closing-heading">{closing.heading}</h2>
        <p class="text-caption cs-section-tag cs-on-ink-soft">07 / The lessons</p>
      </div>
      <div class="cs-closing-grid">
        {
          closing.takeaways.map((t, i) => (
            <div class="cs-closing-item hairline-top reveal">
              <p class="text-caption cs-closing-index tabular-nums">{String(i + 1).padStart(2, "0")}</p>
              <h3 class="text-h3 cs-closing-title">{t.title}</h3>
              <p class="text-small cs-closing-note">{t.note}</p>
            </div>
          ))
        }
      </div>

      <div class="cs-closing-cta reveal">
        <Button href="/#contact" variant="primary-ink">Book a call</Button>
        <Button href="/#work" variant="text-ink">Back to selected work</Button>
      </div>
    </Container>
  </Section>

  <noscript>
    <style>
      .reveal {
        opacity: 1 !important;
        transform: none !important;
      }
    </style>
  </noscript>
</BaseLayout>

<style>
  .cs-kicker {
    color: var(--color-ink-soft);
    margin-bottom: var(--space-4);
  }

  .cs-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
    /* The dashed ring below rotates via CSS transform. A rotated square
       element's axis-aligned bounding box grows past its own layout box
       (up to ~41% wider at a 45deg angle) even though it only ever PAINTS
       as a circle — this was intermittently causing real horizontal page
       overflow depending on which angle the animation had reached when
       measured. Confirmed via a Playwright sweep that caught it at
       1100px/390px but not 1440px/834px (angle-dependent, not viewport-
       dependent). Clipping here only ever trims that rotation artifact —
       there's enough margin in this grid for the ring's intended (static)
       size already. */
    overflow: clip;
  }

  .cs-hero-copy {
    min-width: 0;
  }

  .cs-title {
    max-width: 16ch;
  }

  .cs-channel-title {
    max-width: 14ch;
  }

  .cs-meta-line {
    margin-top: var(--space-4);
    color: var(--color-olive);
  }

  .cs-intro {
    margin-top: var(--space-5);
    max-width: 62ch;
    color: var(--color-olive);
  }

  /* Hero centerpiece — monochrome ring, no neon: ink/olive/bone only. */
  .cs-hero-figure {
    position: relative;
    width: min(320px, 72vw);
    aspect-ratio: 1;
    margin-inline: auto;
    display: grid;
    place-items: center;
  }

  .cs-hero-ring {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
  }

  .cs-hero-ring-mid {
    inset: 10%;
    border-color: var(--color-bone);
  }

  .cs-hero-ring-dashed {
    inset: -8%;
    border-style: dashed;
    border-color: var(--color-line);
    animation: cs-spin 70s linear infinite;
  }

  @keyframes cs-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .cs-hero-figure-center {
    text-align: center;
    padding: var(--space-4);
  }

  .cs-hero-figure-label {
    color: var(--color-ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .cs-hero-figure-value {
    margin-top: var(--space-2);
    font-size: clamp(2.75rem, 6vw + 1rem, 5.5rem);
    color: var(--color-ink);
  }

  .cs-hero-figure-sub {
    margin-top: var(--space-2);
    color: var(--color-olive);
    max-width: 18ch;
    margin-inline: auto;
  }

  .cs-stats {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .cs-footnote {
    margin-top: var(--space-4);
    color: var(--color-ink-soft);
  }

  /* Proof band — a full-width tinted strip right under the hero, the
     reference design's "proof" section. Border-left dividers instead of
     cards, numbers given real room to breathe. */
  .cs-proof-header {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-olive);
    padding-bottom: var(--space-5);
  }

  .cs-proof-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .cs-proof-item {
    /* Not --color-line: it's literally the same hex as --color-bone, so
       a divider in that color would be invisible on this section's bone
       background. ink-soft actually shows up here. */
    border-left: 1px solid var(--color-ink-soft);
    padding: var(--space-4) var(--space-5) 0;
  }

  .cs-proof-item:first-child {
    border-left: 0;
    padding-left: 0;
  }

  /* Below 768px the grid is 2 columns, so every row-leading item (1st and
     3rd) needs its divider reset, not just the very first — otherwise the
     3rd item's left border reads as a stray line at its new row's start. */
  @media (max-width: 767px) {
    .cs-proof-item:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }
  }

  .cs-proof-figure {
    font-size: clamp(2rem, 4vw + 0.5rem, 3.5rem);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .cs-proof-item:hover .cs-proof-figure {
    color: var(--color-olive);
  }

  .cs-proof-label {
    margin-top: var(--space-3);
    color: var(--color-olive);
    max-width: 22ch;
  }

  /* Shared section-head: heading + side note to the right, per
     DESIGN-SYSTEM.md §4.2 — never a label ABOVE the heading. */
  .cs-section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-5);
    padding-top: var(--space-5);
    margin-bottom: var(--space-7);
  }

  .cs-section-tag {
    color: var(--color-ink-soft);
    white-space: nowrap;
  }

  .cs-on-ink {
    color: var(--color-paper) !important;
  }

  .cs-on-ink-soft {
    color: var(--color-ink-soft) !important;
  }

  .cs-brief-display {
    max-width: 14ch;
  }

  .cs-body-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .cs-block + .cs-block {
    margin-top: var(--space-7);
  }

  .cs-block-text {
    margin-top: var(--space-3);
    max-width: 62ch;
    color: var(--color-olive);
  }

  .cs-list {
    margin-top: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-left: var(--space-5);
    color: var(--color-olive);
  }

  .cs-list li {
    list-style: disc;
  }

  .cs-approach-list {
    margin-top: var(--space-4);
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .cs-approach-row {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-line);
    transition: padding-left var(--dur-fast) var(--ease-out);
  }

  .cs-approach-row:hover {
    padding-left: var(--space-3);
  }

  .cs-approach-row:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .cs-approach-index {
    color: var(--color-ink-soft);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .cs-approach-row:hover .cs-approach-index {
    color: var(--color-ink);
  }

  .cs-approach-text {
    color: var(--color-ink);
    max-width: 58ch;
  }

  .cs-sidebar {
    padding-top: var(--space-5);
    align-self: start;
  }

  .cs-sidebar-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .cs-sidebar-list dt {
    color: var(--color-ink-soft);
    margin-bottom: var(--space-1);
  }

  .cs-sidebar-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .cs-section-note {
    color: var(--color-olive);
    max-width: 320px;
    margin-top: calc(var(--space-7) * -1 + var(--space-3));
    margin-bottom: var(--space-6);
  }

  .cs-chart-stage {
    position: relative;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    padding: clamp(var(--space-5), 4vw, var(--space-8));
  }

  .cs-chart-stage-corner {
    position: absolute;
    top: -1px;
    right: -1px;
    width: 56px;
    height: 56px;
    border-top: 1px solid var(--color-ink);
    border-right: 1px solid var(--color-ink);
    pointer-events: none;
  }

  .cs-chart-stage-hint {
    color: var(--color-ink-soft);
    margin-bottom: var(--space-5);
  }

  .cs-chart-stage-tint {
    background: var(--color-paper-2);
  }

  .cs-glossary {
    color: var(--color-ink-soft);
    margin: var(--space-4) 0;
  }

  .cs-chart-caption {
    margin-top: var(--space-3);
    color: var(--color-ink-soft);
  }

  .cs-table-wrap {
    margin-top: var(--space-7);
    overflow-x: auto;
  }

  .cs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-small);
  }

  .cs-table caption {
    text-align: left;
    color: var(--color-ink-soft);
    margin-bottom: var(--space-3);
  }

  .cs-table th,
  .cs-table td {
    text-align: right;
    padding: var(--space-3) var(--space-2);
    border-bottom: 1px solid var(--color-line);
  }

  .cs-table th[scope="row"] {
    text-align: left;
    color: var(--color-ink);
    font-weight: 450;
  }

  .cs-table thead th {
    color: var(--color-ink-soft);
    font-weight: 450;
    border-bottom: 1px solid var(--color-ink);
  }

  .cs-takeaway {
    margin-top: var(--space-3);
    color: var(--color-ink);
    max-width: 62ch;
  }

  .cs-insight {
    margin-top: var(--space-9);
    padding-top: var(--space-7);
    border-top: 1px solid var(--color-line);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: center;
  }

  .cs-insight-figure {
    /* Deliberately NOT .text-display-xl (that scale is sized for a
       near-full-viewport hero, see tokens.css). This number sits in a
