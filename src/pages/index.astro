---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/layout/Container.astro";
import Section from "../components/layout/Section.astro";
---

<BaseLayout title="Kemal — Senior Growth Specialist">
  <Section id="top">
    <Container>
      <p class="text-caption" style="color: var(--color-olive)">Phase 1 — foundation</p>
      <h1 class="text-h1" style="margin-top: var(--space-4)">
        Home page sections land in Phase 2.
      </h1>
      <p class="text-lead" style="margin-top: var(--space-5); color: var(--color-olive)">
        This page exists to prove the layout shell (nav, footer, tokens, type scale)
        is wired correctly. See <a href="/styleguide" class="underline">/styleguide</a>
        for every token and component.
      </p>
    </Container>
  </Section>
</BaseLayout>
